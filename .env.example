# Ultimate Kilo Docker Sandbox Environment Configuration
# Skeptic-audited August 2026 — Ubuntu 26.04 LTS "Resolute Raccoon"

# ── Container Service Ports ──
KILO_PORT=8081
VSCODE_PORT=8085
GUI_NOVNC_PORT=6080
FIREBASE_UI_PORT=4000
MYSQL_PORT=3306
REDIS_PORT=6379
REDIS_UI_PORT=8087
PMA_PORT=8086

# ── Hardware Resource Limits (Ryzen 5 5500 + 48GB DDR4 RAM Host) ──
CPU_LIMIT=10
MEMORY_LIMIT=25G

# ── Database Settings ──
MYSQL_ROOT_PASSWORD=secret
MYSQL_DATABASE=sandbox_db
MYSQL_USER=root
MYSQL_PASSWORD=secret

# ── Cloud LLM API Keys (fill in your keys) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEVIN_API_KEY=
KIMI_API_KEY=

# ── Optional: Additional Service Keys ──
# FIREBASE_TOKEN=
# GITHUB_TOKEN=
# VERCEL_TOKEN=
# NETLIFY_AUTH_TOKEN=
# SUPABASE_ACCESS_TOKEN=
