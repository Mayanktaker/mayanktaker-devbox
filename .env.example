# © Mayanktaker Computers & Web Development | https://mayanktaker.com
# Mayanktaker Devbox Environment Configuration
# Skeptic-audited August 2026 — Ubuntu 26.04 LTS "Resolute Raccoon"

# ── Container Service Ports ──
AGENT_PORT=8081
VSCODE_PORT=8085
GUI_NOVNC_PORT=6080
FIREBASE_UI_PORT=4000
MYSQL_PORT=3306
REDIS_PORT=6379
REDIS_UI_PORT=8087
PMA_PORT=8086
PG_PORT=5432
PGADMIN_PORT=8088
MONGO_PORT=27017
ME_PORT=8089

# ── Hardware Resource Limits (Ryzen 5 5500 + 48GB DDR4 RAM Host) ──
CPU_LIMIT=10
MEMORY_LIMIT=25G

# ── Stack Runtime Versions (Recommended Defaults) ──
NODE_VERSION=24
PHP_VERSION=8.5
JAVA_VERSION=21

# ── Database Engine Options ──
DB_ENGINE=mysql
DB_ENGINE_IMAGE=mysql:8.4
REDIS_ENGINE_IMAGE=redis:8-alpine
MYSQL_ROOT_PASSWORD=secret
MYSQL_DATABASE=sandbox_db
MYSQL_USER=root
MYSQL_PASSWORD=secret
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=sandbox_db
MONGO_USER=root
MONGO_PASSWORD=secret

# ── Component Modular Flags (managed by ./manage.sh wizard) ──
ENABLE_AI_AGENTS=true
ENABLE_FLUTTER_ANDROID=true
ENABLE_PLAYWRIGHT=true
ENABLE_PHP=true
ENABLE_MYSQL=true
ENABLE_POSTGRES=false
ENABLE_MONGO=false
ENABLE_REDIS=true
ENABLE_FIREBASE=true
ENABLE_DEV_TOOLS=true
ENABLE_COMPOSER=true
ENABLE_BUN=true
ENABLE_UV=true
ENABLE_RUST=true
ENABLE_GO=false
ENABLE_DENO=false
ENABLE_CPP_TOOLCHAIN=false
ENABLE_ZSH=true
ENABLE_FISH=false
ENABLE_NEOVIM=true
ENABLE_MICRO=true
ENABLE_HELIX=false
ENABLE_WEB_TOOLING=true
ENABLE_POSTGRES_CLIENT=true

# ── AI Provider & Router API Keys ──
# (Fill in your keys below — they are auto-exported to all container agents)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
KILO_API_KEY=
OPENCODE_API_KEY=
DEVIN_API_KEY=
KIMI_API_KEY=
CURSOR_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# ── Cloud Platform & Developer Tokens (Optional) ──
GITHUB_TOKEN=
FIREBASE_TOKEN=
VERCEL_TOKEN=
NETLIFY_AUTH_TOKEN=
SUPABASE_ACCESS_TOKEN=
CLOUDFLARE_API_TOKEN=
