# © Mayanktaker Computers & Web Development | https://mayanktaker.com
# Ultimate Multi-Agent Sandbox Dockerfile (Ubuntu 26.04 LTS "Resolute Raccoon")
# Skeptic-audited & 100% Modular Stack:
# Runtimes: Node, PHP, Java, Rust, Go, Bun, UV, Composer, Deno, C/C++ Toolchain, Kotlin
# Mobile Dev: Flutter/Android, React Native Expo CLI, Fastlane, Watchman, Android NDK
# Display & GUI: X11 / Xvfb, noVNC Web, Wayland / XWayland Host Forwarding & Weston Compositor
# Shells: Bash, Zsh (+ Oh My Zsh/Starship), Fish
# Editors: VS Code Web (code-server), VSCodium Web (openvscode-server Telemetry-Free), Neovim/Vim, Micro, Helix
# Web Tools: AI Agents, Playwright, Lighthouse, Web Scaffolding CLIs (Next, Astro, Vite, Tailwind)

FROM ubuntu:26.04 AS base

# Modular Feature & Stack Version Build Arguments (100% Customizable via Setup Wizard)
ARG NODE_VERSION=24
ARG PHP_VERSION=8.5
ARG JAVA_VERSION=21
ARG INSTALL_AI_AGENTS=true
ARG INSTALL_FLUTTER_ANDROID=true
ARG INSTALL_EXPO=true
ARG INSTALL_FASTLANE=true
ARG INSTALL_KOTLIN=true
ARG INSTALL_LIGHTHOUSE=true
ARG INSTALL_WATCHMAN=true
ARG INSTALL_PLAYWRIGHT=true
ARG INSTALL_PHP=true
ARG INSTALL_DEV_TOOLS=true
ARG INSTALL_FIREBASE=true
ARG INSTALL_COMPOSER=true
ARG INSTALL_BUN=true
ARG INSTALL_UV=true
ARG INSTALL_RUST=true
ARG INSTALL_GO=false
ARG INSTALL_DENO=false
ARG INSTALL_CPP_TOOLCHAIN=false
ARG INSTALL_ZSH=true
ARG INSTALL_FISH=false
ARG INSTALL_VSCODE_WEB=true
ARG INSTALL_VSCODIUM_WEB=true
ARG INSTALL_WAYLAND=true
ARG INSTALL_NEOVIM=true
ARG INSTALL_MICRO=true
ARG INSTALL_HELIX=false
ARG INSTALL_WEB_TOOLING=true
ARG INSTALL_POSTGRES_CLIENT=true

# Prevent interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=development \
    DISPLAY=:99 \
    ANDROID_HOME=/opt/android-sdk \
    FLUTTER_HOME=/opt/flutter \
    CHROME_BIN=/usr/bin/chromium-browser \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers \
    PATH="/opt/openvscode-server/bin:/home/agent/.cargo/bin:/home/agent/.deno/bin:/usr/local/go/bin:/home/agent/.local/bin:/home/agent/.bun/bin:/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:${PATH}"

# ── Layer 1: Core Ubuntu system packages, build tools, Java & Wayland/X11 libraries ──
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    gnupg \
    ca-certificates \
    sudo \
    ripgrep \
    build-essential \
    unzip \
    zip \
    sqlite3 \
    libsqlite3-dev \
    default-mysql-client \
    redis-tools \
    software-properties-common \
    openjdk-${JAVA_VERSION}-jdk-headless \
    tmux \
    fzf \
    jq \
    htop \
    ncdu \
    tldr \
    tree \
    zoxide \
    bat \
    eza \
    fd-find \
    python3 \
    python3-pip \
    python3-venv \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    dbus-x11 \
    weston \
    wayland-protocols \
    libwayland-client0 \
    libwayland-egl1 \
    libwayland-server0 \
    qt6-wayland \
    qt5-wayland \
    libgtk-3-0 \
    libnss3 \
    libxss1 \
    libxtst6 \
    libgbm1 \
    libx11-xcb1 \
    libxcb-dri3-0 \
    chromium-browser \
    fonts-liberation \
    libasound2t64 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libpango-1.0-0 \
    libcairo2 \
    cmake \
    ninja-build \
    pkg-config \
    clang \
    whiptail \
    && rm -rf /var/lib/apt/lists/*

# ── Layer 2: PostgreSQL Client (Conditional) ──
RUN if [ "$INSTALL_POSTGRES_CLIENT" = "true" ]; then \
      apt-get update && apt-get install -y --no-install-recommends postgresql-client && \
      rm -rf /var/lib/apt/lists/* ; \
    fi

# ── Layer 3: Shells (Zsh, Starship, Fish - Conditional) ──
RUN if [ "$INSTALL_ZSH" = "true" ]; then \
      apt-get update && apt-get install -y zsh && rm -rf /var/lib/apt/lists/* && \
      curl -sS https://starship.rs/install.sh | sh -s -- -y || true ; \
    fi && \
    if [ "$INSTALL_FISH" = "true" ]; then \
      add-apt-repository -y ppa:fish-shell/release-3 && \
      apt-get update && apt-get install -y fish && rm -rf /var/lib/apt/lists/* ; \
    fi

# ── Layer 4: Editors (Neovim/Vim, Micro, Helix - Conditional) ──
RUN if [ "$INSTALL_NEOVIM" = "true" ]; then \
      apt-get update && apt-get install -y neovim vim && rm -rf /var/lib/apt/lists/* ; \
    fi && \
    if [ "$INSTALL_MICRO" = "true" ]; then \
      curl https://getmic.ro | bash && mv micro /usr/local/bin/ ; \
    fi && \
    if [ "$INSTALL_HELIX" = "true" ]; then \
      add-apt-repository -y ppa:maveonair/helix-editor && \
      apt-get update && apt-get install -y helix && rm -rf /var/lib/apt/lists/* ; \
    fi

# ── Layer 5: Kotlin Compiler & Fastlane (Conditional) ──
RUN if [ "$INSTALL_KOTLIN" = "true" ]; then \
      apt-get update && apt-get install -y kotlin && rm -rf /var/lib/apt/lists/* ; \
    fi && \
    if [ "$INSTALL_FASTLANE" = "true" ]; then \
      apt-get update && apt-get install -y ruby-full ruby-dev && \
      gem install fastlane -N || true && \
      rm -rf /var/lib/apt/lists/* ; \
    fi && \
    if [ "$INSTALL_WATCHMAN" = "true" ]; then \
      apt-get update && apt-get install -y watchman || true && \
      rm -rf /var/lib/apt/lists/* ; \
    fi

# ── Layer 6: C/C++ Modern Systems Toolchain (Conditional) ──
RUN if [ "$INSTALL_CPP_TOOLCHAIN" = "true" ]; then \
      apt-get update && apt-get install -y --no-install-recommends \
      clang-18 llvm-18 gdb lldb valgrind && rm -rf /var/lib/apt/lists/* ; \
    fi

# ── Layer 7: GitHub CLI ──
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | gpg --dearmor -o /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null && \
    apt-get update && apt-get install -y gh && \
    rm -rf /var/lib/apt/lists/*

# ── Layer 8: Node.js (Configurable: Node 24 LTS default) ──
RUN curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_VERSION}.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# ── Layer 9: PHP & Composer (Conditional on INSTALL_PHP & INSTALL_COMPOSER) ──
RUN if [ "$INSTALL_PHP" = "true" ]; then \
      add-apt-repository -y ppa:ondrej/php && \
      apt-get update && apt-get install -y --no-install-recommends \
      php${PHP_VERSION}-cli php${PHP_VERSION}-mysql php${PHP_VERSION}-pgsql php${PHP_VERSION}-sqlite3 php${PHP_VERSION}-redis php${PHP_VERSION}-curl php${PHP_VERSION}-mbstring \
      php${PHP_VERSION}-xml php${PHP_VERSION}-zip php${PHP_VERSION}-intl php${PHP_VERSION}-gd php${PHP_VERSION}-bcmath php${PHP_VERSION}-xdebug && \
      if [ "$INSTALL_COMPOSER" = "true" ]; then apt-get install -y composer ; fi && \
      rm -rf /var/lib/apt/lists/* ; \
    fi

# ── Layer 10: VS Code Web (code-server) & VSCodium Web (openvscode-server), Bun, pnpm, yarn, Deno ──
RUN if [ "$INSTALL_VSCODE_WEB" = "true" ]; then \
      curl -fsSL https://code-server.dev/install.sh | sh ; \
    fi && \
    if [ "$INSTALL_VSCODIUM_WEB" = "true" ]; then \
      mkdir -p /opt/openvscode-server && \
      curl -fsSL https://github.com/gitpod-io/openvscode-server/releases/download/openvscode-server-v1.96.0/openvscode-server-v1.96.0-linux-x64.tar.gz | tar -C /opt/openvscode-server --strip-components=1 -xz || true ; \
    fi
RUN npm install -g pnpm yarn
RUN if [ "$INSTALL_BUN" = "true" ]; then curl -fsSL https://bun.sh/install | bash ; fi
RUN if [ "$INSTALL_DENO" = "true" ]; then curl -fsSL https://deno.land/install.sh | sh ; fi

# ── Layer 11: Expo CLI, React Native CLI, Lighthouse & Web Tooling ──
RUN if [ "$INSTALL_EXPO" = "true" ]; then \
      npm install -g expo-cli eas-cli react-native-cli || true ; \
    fi && \
    if [ "$INSTALL_LIGHTHOUSE" = "true" ]; then \
      npm install -g lighthouse || true ; \
    fi && \
    if [ "$INSTALL_WEB_TOOLING" = "true" ]; then \
      npm install -g astro next vite turbo biome @tailwindcss/cli || true ; \
    fi

# ── Layer 12: uv (Python package manager), Aider & DeepSeek harness ──
RUN pip3 install --no-cache-dir --break-system-packages httpie ruff && \
    if [ "$INSTALL_UV" = "true" ]; then curl -LsSf https://astral.sh/uv/install.sh | sh ; fi && \
    if [ "$INSTALL_AI_AGENTS" = "true" ]; then \
      pip3 install --no-cache-dir --break-system-packages aider-chat lm-eval transformers ; \
    fi

# ── Layer 13: Rust Toolchain (rustup, cargo, rustc) ──
RUN if [ "$INSTALL_RUST" = "true" ]; then \
      curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y ; \
    fi

# ── Layer 14: Go Language (Golang) ──
RUN if [ "$INSTALL_GO" = "true" ]; then \
      curl -fsSL https://go.dev/dl/go1.23.0.linux-amd64.tar.gz | tar -C /usr/local -xz ; \
    fi

# ── Layer 15: Flutter SDK + Dart (Conditional on INSTALL_FLUTTER_ANDROID) ──
RUN if [ "$INSTALL_FLUTTER_ANDROID" = "true" ]; then \
      git clone https://github.com/flutter/flutter.git -b stable --depth 1 /opt/flutter && \
      /opt/flutter/bin/flutter --disable-analytics && \
      /opt/flutter/bin/flutter config --no-analytics && \
      /opt/flutter/bin/dart --disable-analytics && \
      /opt/flutter/bin/flutter precache --android --web ; \
    else \
      mkdir -p /opt/flutter ; \
    fi

# ── Layer 16: Android SDK command-line tools (Conditional on INSTALL_FLUTTER_ANDROID) ──
RUN if [ "$INSTALL_FLUTTER_ANDROID" = "true" ]; then \
      mkdir -p ${ANDROID_HOME}/cmdline-tools && \
      curl -fsSL https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -o /tmp/cmdline-tools.zip && \
      unzip -q /tmp/cmdline-tools.zip -d ${ANDROID_HOME}/cmdline-tools && \
      mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest && \
      rm /tmp/cmdline-tools.zip && \
      yes | ${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager --licenses > /dev/null 2>&1 && \
      ${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager "platform-tools" "build-tools;35.0.0" "platforms;android-35" && \
      /opt/flutter/bin/flutter config --android-sdk ${ANDROID_HOME} && \
      chmod -R 755 ${ANDROID_HOME} ; \
    else \
      mkdir -p ${ANDROID_HOME} ; \
    fi

# ── Layer 17: Playwright + Chromium browsers (Conditional on INSTALL_PLAYWRIGHT) ──
RUN if [ "$INSTALL_PLAYWRIGHT" = "true" ]; then \
      npx playwright install --with-deps chromium || true ; \
    fi

# ── Layer 18: lazygit + lazydocker TUI tools (Conditional on INSTALL_DEV_TOOLS) ──
RUN if [ "$INSTALL_DEV_TOOLS" = "true" ]; then \
      curl -fsSL https://raw.githubusercontent.com/jesseduffield/lazygit/master/scripts/install_update_linux.sh | bash && \
      curl -fsSL https://raw.githubusercontent.com/jesseduffield/lazydocker/master/scripts/install_update_linux.sh | bash ; \
    fi

# ── Layer 19: AI Multi-Agent CLI Tools, ORMs & Firebase (npm global) ──
RUN if [ "$INSTALL_AI_AGENTS" = "true" ]; then \
      npm install -g --allow-scripts \
      prisma drizzle-kit \
      @anthropic-ai/claude-code @kilocode/cli @commandcode/cli openchamber-cli \
      pi-agent hermes-agent @openai/codex @cursor/cli paseo-cli zcode t3code \
      @google/gemini-cli tsx nodemon pm2 || true ; \
    fi && \
    if [ "$INSTALL_FIREBASE" = "true" ]; then \
      npm install -g firebase-tools || true ; \
    fi

# ── Layer 20: Devin CLI (pip, conditional on INSTALL_AI_AGENTS) ──
RUN if [ "$INSTALL_AI_AGENTS" = "true" ]; then \
      pip3 install --no-cache-dir --break-system-packages devin-cli || true ; \
    fi

# ── Layer 21: Antigravity CLI (official install script, conditional on INSTALL_AI_AGENTS) ──
RUN if [ "$INSTALL_AI_AGENTS" = "true" ]; then \
      curl -fsSL https://antigravity.google/cli/install.sh | bash || true ; \
    fi

# ── Layer 22: bat/fd symlinks ──
RUN mkdir -p /usr/local/bin && \
    ln -sf /usr/bin/batcat /usr/local/bin/bat 2>/dev/null || true && \
    ln -sf /usr/bin/fdfind /usr/local/bin/fd 2>/dev/null || true

# ── Layer 23: Auto-updater script ──
RUN echo '#!/usr/bin/env bash\necho "[+] Updating installed CLI tools, Flutter & packages..."\nnpm update -g\npip3 install --upgrade httpie ruff --break-system-packages\nif [ -d "/opt/flutter/.git" ]; then /opt/flutter/bin/flutter upgrade; fi\necho "[✓] All tools updated!"' > /usr/local/bin/update-tools && \
    chmod +x /usr/local/bin/update-tools

# ── Layer 24: Create non-root developer user 'agent' with passwordless sudo ──
RUN useradd -m -u 1000 -s /bin/bash agent && \
    echo "agent ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    mkdir -p /workspace /home/agent/.kilo /home/agent/.ssh /home/agent/.cache/composer \
             /home/agent/.config/code-server /home/agent/.config/openvscode-server /home/agent/.config/configstore \
             /home/agent/.local/share/code-server /home/agent/.local/share/openvscode-server /home/agent/.android /home/agent/.cargo && \
    echo 'alias fb="firebase"\nalias c="claude"\nalias k="kilo"\nalias a="aider"\nalias db="mysql -u root -psecret -h mysql-db sandbox_db"\nalias pg="psql -h postgres-db -U postgres sandbox_db"\nalias r="redis-cli -h redis-cache"\nalias gs="git status"\nalias lg="lazygit"\nalias ld="lazydocker"\nalias cat="bat --paging=never"\nalias ls="eza --icons --group-directories-first"\nalias find="fd"\nalias flutter="/opt/flutter/bin/flutter"\nalias dart="/opt/flutter/bin/dart"' >> /home/agent/.bashrc && \
    chown -R agent:agent /workspace /home/agent /opt/flutter /opt/android-sdk /opt/openvscode-server 2>/dev/null || true

# Switch to non-root user
USER agent

# Set working directory to mounted workspace
WORKDIR /workspace

# Expose: VSCodium Web(8084), Kilo(8081), VS Code(8085), noVNC(6080), Firebase Emulators(4000,9099,8082,9000,5001,5000)
EXPOSE 8084 8081 8085 6080 4000 9099 8082 9000 5001 5000

# Healthcheck: verify web IDE is responding
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8085/healthz || curl -f http://localhost:8084/healthz || exit 1

# Default entrypoint: Start X11, noVNC, code-server / openvscode-server & Kilo daemon
CMD ["sh", "-c", "Xvfb :99 -screen 0 1920x1080x24 >/dev/null 2>&1 & x11vnc -display :99 -forever -shared -nopw -rfbport 5900 >/dev/null 2>&1 & websockify --web /usr/share/novnc 6080 localhost:5900 >/dev/null 2>&1 & (if command -v code-server >/dev/null 2>&1; then code-server --bind-addr 0.0.0.0:8085 --auth none /workspace & fi) & (if [ -f /opt/openvscode-server/bin/openvscode-server ]; then /opt/openvscode-server/bin/openvscode-server --host 0.0.0.0 --port 8084 --without-connection-token /workspace & fi) & kilo serve --host 0.0.0.0 --port 8081"]
